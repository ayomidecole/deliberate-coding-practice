{
  "name": "deliberate-coding-practice",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "test": "vitest run",
    "test:all": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "test:go": "go test ./...",
    "check:typescript": "npm run typecheck && npm test",
