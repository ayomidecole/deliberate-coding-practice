{
  "name": "deliberate-coding-practice",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "test": "vitest run",
    "test:all": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "test:go": "go test ./...",
    "check:typescript": "npm run typecheck && npm test",
    "check:go": "go vet ./... && go test ./...",
    "check": "npm run check:typescript && npm run check:go"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "jsdom": "^26.1.0",
    "typescript": "7.0.2",
    "vite": "^8.2.0",
    "vitest": "4.1.10"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  }
}
